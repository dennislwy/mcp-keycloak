# Keycloak Server Configuration
# Required credentials for connecting to Keycloak Admin API

# Server URL (do NOT include /auth - it's added automatically)
SERVER_URL=http://localhost:8080

# Admin credentials (must have admin privileges)
USERNAME=admin
PASSWORD=admin

# Target realm for operations (defaults to "master")
REALM_NAME=master

# Optional OAuth2 client authentication
CLIENT_ID=admin-cli
CLIENT_SECRET=

# Optional: Transport mode for MCP server
# TRANSPORT=stdio  # Default: stdio mode for local CLI tools
# TRANSPORT=http   # HTTP mode for network access

# Optional: HTTP server port (only used when TRANSPORT=http)
# PORT=8000